# local setup state and python virtual environment created by SETUP.cmd / SETUP.sh
.setup/
.venv/
venv/

# local tool manager config
mise.toml

# the saved workbench output, which generats everytime a solution is ran
practice/

# python files
__pycache__/
*.py[cod]
*.pyd
*.egg-info/
/build/
/dist/

# keep the Windows offline setup payload intact (manifest.json verifies all files)
!.setup-payload/
!.setup-payload/**
!.setup-payload/**/__pycache__/
!.setup-payload/**/__pycache__/**

# logs
*.log

# IDE or Editor Files
.idea/
.vscode/
*.iml

# OS Junk Files
Thumbs.db
desktop.ini
.DS_Store
